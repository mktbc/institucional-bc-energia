{
  "name": "institucional-grupo-bc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node --import tsx scripts/generate-sitemap.ts && node --import tsx scripts/generate-llms.ts && vite build --mode production && node --import tsx scripts/prerender.ts",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "predev": "node --import tsx scripts/generate-sitemap.ts && node --import tsx scripts/generate-llms.ts",
    "prerender": "node --import tsx scripts/prerender.ts",
    "audit:indexing-content": "node --import tsx scripts/audit-content-indexing.ts",
    "audit:images": "node --import tsx scripts/audit-images-performance.ts",
    "audit:js": "node --import tsx scripts/audit-js-bundles.ts",
    "audit:fonts": "node --import tsx scripts/audit-fonts-performance.ts",
    "audit:thirdparty": "node --import tsx scripts/audit-third-party-performance.ts",
    "audit:budget": "node --import tsx scripts/audit-performance-budget.ts",
    "audit:performance": "npm run audit:images && npm run audit:js && npm run audit:fonts && npm run audit:thirdparty && npm run audit:budget",
    "audit:design-system": "node --import tsx scripts/audit-design-system.ts",
    "audit:navigation": "node --import tsx scripts/audit-navigation.ts",
    "seo:generate": "node --import tsx scripts/generate-sitemap.ts && node --import tsx scripts/generate-llms.ts",
    "n8n:build": "node scripts/build-n8n-workflow.mjs",
    "test:n8n": "node scripts/test-n8n-workflow.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@supabase/supabase-js": "^2.110.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2",
    "swiper": "^14.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  }
}
