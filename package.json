{
  "name": "bc_energia",
  "version": "0.1.0",
  "private": true,
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "scripts": {
    "prepare": "husky install",
    "clean": "rimraf .next && rimraf build",
    "format": "prettier --write . --log-level silent",
    "lint": "eslint . --ext .ts,.tsx --ignore-path .gitignore --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "commit": "git add . && git cz && node .husky/gitpush.mjs",
    "dev": "next dev",
    "start": "next start",
    "build": "rimraf .next && rimraf build && next build"
  },
  "dependencies": {
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swiper": "^11.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.1.0",
    "@commitlint/config-conventional": "^19.1.0",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5",
    "@typescript-eslint/parser": "^5",
    "autoprefixer": "^10.4.18",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "git-cz": "^4.9.0",
    "husky": "^9.0.11",
    "inquirer": "^9.2.16",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "rimraf": "^5.0.5",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
