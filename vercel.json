{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/produtos/irec",
      "destination": "/produtos/certificacao-renovavel-irec",
      "statusCode": 301
    },
    {
      "source": "/documentos/campanha_com_fidelidade_2anos",
      "destination": "/docs/campanha_com_fidelidade_2anos.pdf",
      "statusCode": 301
    },
    {
      "source": "/documentos/campanha_sem_fidelidade",
      "destination": "/docs/campanha_sem_fidelidade.pdf",
      "statusCode": 301
    },
    {
      "source": "/documentos/condicoes_gerais_gd",
      "destination": "/docs/condicoes_gerais_gd.pdf",
      "statusCode": 301
    },
    {
      "source": "/documentos/condicoes_gerais_gd_v2",
      "destination": "/docs/condicoes_gerais_gd_v2.pdf",
      "statusCode": 301
    },
    {
      "source": "/documentos/condicoes_gerais_gd_alta_tensao",
      "destination": "/docs/condicoes_gerais_gd_alta_tensao.pdf",
      "statusCode": 301
    },
    {
      "source": "/documentos/condicoes_gerais_gd_externo",
      "destination": "/docs/condicoes_gerais_gd_externo.pdf",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
